@using IntercityTransportManagementSystem.Models
@using IntercityTransportManagementSystem.Enums
@model Payment

@{
	ViewData["Title"] = "Анулиране на плащане";

	decimal euroCourse = 1.95583m;
	decimal eurPrice = Model.Reservation.Schedule.Route.TicketPrice;
	decimal priceInLeva = eurPrice * euroCourse;

	bool isPaidOnline = Model.PaymentMethod == PaymentMethod.Online;
}

<div class="container mt-5">
	<div class="row justify-content-center">
		<div class="col-md-6">
			<div class="card border-danger shadow">
				<div class="card-header bg-danger text-white text-center">
					<h4 class="mb-0"><i class="bi bi-exclamation-triangle me-2"></i> Потвърждение за анулиране</h4>
				</div>
				<div class="card-body p-4">
					<p class="text-center fw-semibold mb-3">
						Сигурни ли сте, че искате да анулирате това плащане и да освободите мястото?
					</p>
					
					<div class="alert alert-warning text-center mb-4">
						<i class="bi bi-info-circle me-2"></i>
						След анулиране, мястото ще стане достъпно за други пътници.
					</div>
					
					<hr />
					<dl class="row mb-0">
						<dt class="col-sm-5 text-muted">Пътник:</dt>
						<dd class="col-sm-7 fw-bold">@Model.Passenger.Name @Model.Passenger.LastName</dd>
						
						<dt class="col-sm-5 text-muted">Маршрут:</dt>
						<dd class="col-sm-7 fw-bold">@Model.Reservation.Schedule.Route.StartDestination - @Model.Reservation.Schedule.Route.FinalDestination</dd>
						
						<dt class="col-sm-5 text-muted">Дата и час:</dt>
						<dd class="col-sm-7 fw-bold">@Model.Reservation.Schedule.TravelDate.ToString("dd.MM.yyyy") @Model.Reservation.Schedule.DepartureTime.ToString("HH:mm")</dd>
						
						<dt class="col-sm-5 text-muted">Платена сума:</dt>
						<dd class="col-sm-7 fw-bold">@eurPrice.ToString("F2") € / (@priceInLeva.ToString("F2") лв.)</dd>
					</dl>
				</div>

				<div class="card-footer bg-light d-flex justify-content-between align-items-center">
					<a asp-action="Index" class="btn btn-secondary">Отказ</a>
					<form asp-action="CancelPayment" method="post" class="mb-0">
						@Html.AntiForgeryToken()
						<input type="hidden" asp-for="Id" name="id" />
						<button type="submit" class="btn btn-danger" data-ajax="false"><i class="bi bi-trash me-2"></i> Анулирай билета</button>
					</form>
				</div>
			</div>
		</div>
	</div>
</div>