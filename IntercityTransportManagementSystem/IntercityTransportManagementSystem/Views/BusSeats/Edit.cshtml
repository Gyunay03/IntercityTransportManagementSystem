@model IntercityTransportManagementSystem.Models.BusSeat

@{
    ViewData["Title"] = "Редактиране на място в автобус";
    Layout = "~/Views/Shared/_AdministratorLayout.cshtml";
}

<h2 class="text-center mb-4">Редактиране на място в автобус</h2>
<hr />
<div class="form-narrow">
    <form asp-action="Edit">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <input type="hidden" asp-for="Id" />
            
        <div class="form-group">
                <label asp-for="Number" class="form-label"></label>
                <input asp-for="Number" class="form-control" />
                <span asp-validation-for="Number" class="text-danger"></span>
        </div>
            
        <div class="form-group">
                <label asp-for="BusId" class="form-label"></label>
                <select asp-for="BusId" class="form-select" asp-items="ViewBag.BusId"></select>
                <span asp-validation-for="BusId" class="text-danger"></span>
        </div>
            
        <div class="d-flex justify-content-center gap-2 mt-4">
            <a asp-action="Index" class="btn btn-secondary">Откажи</a>
            <input type="submit" value="Запази" class="btn btn-primary" />
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
