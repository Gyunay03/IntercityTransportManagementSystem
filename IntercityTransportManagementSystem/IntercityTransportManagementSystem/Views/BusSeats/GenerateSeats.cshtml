@{
	ViewData["Title"] = "Генериране на места";
}


@{
	var buses = ViewData["BusId"] as SelectList;
}

<div class="container mt-4">
	<div class="card shadow p-4">
		<h2 class="text-center mb-4">Генериране на места в автобус</h2>
		<hr />

		<form asp-action="GenerateSeats" method="post">
			<div class="mb-3">
				<label class="form-label">Изберете автобус</label>
				<select name="busId" 
					asp-items="buses"
					class="form-select">
				</select>
			</div>

			<div class="text-center">
				<input type="submit" class="btn btn-success" value="Генерирай места"/>
				<a asp-action="Index" class="btn btn-secondary ms-2">Назад</a>
			</div>
		</form>
	</div>
</div>
