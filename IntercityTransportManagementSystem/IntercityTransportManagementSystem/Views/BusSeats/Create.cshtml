@model IntercityTransportManagementSystem.Models.BusSeat

@{
    ViewData["Title"] = "Добавяне на място в автобус";
    Layout = "~/Views/Shared/_AdministratorLayout.cshtml";
}

<h2 class="text-center mt-4">Добавяне на място в автобус</h2>
<hr />

<div class="d-flex justify-content-center">
    <div style="max-width: 400px; width: 100%;">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            
            <div class="mb-3">
                <label asp-for="Number" class="form-label"></label>
                <input asp-for="Number" class="form-control" />
                <span asp-validation-for="Number" class="text-danger"></span>
            </div>
            
            <div class="mb-3">
                <label asp-for="BusId" class="form-label"></label>
                <select asp-for="BusId" class ="form-select" asp-items="ViewBag.BusId">
                    <option value="">Изберете автобус</option>
                </select>
            </div>
            
            <div class="d-flex justify-content-center gap-2 mt-4">
                <a asp-action="Index" class="btn btn-secondary">Откажи</a>
                <input type="submit" value="Добави" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
