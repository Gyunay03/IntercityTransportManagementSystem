@using IntercityTransportManagementSystem.ViewModels
@model ForgotPasswordViewModel
@{
	ViewData["Title"] = "Забравена парола";
}

<div class="account-container">
	<div class="account-box">
		<h2 class="text-center mb-4">Забравена парола</h2>
		<form asp-action="ForgotPassword" method="post">
			@Html.AntiForgeryToken()

			<div asp-validation-summary="ModelOnly" class="text-danger"></div>
			
			<div class="mb-3">
				<label asp-for="Email" class="form-label"></label>
				<input asp-for="Email" class="form-control" placeholder="example@mail.com" autofocus />
				<span asp-validation-for="Email" class="text-danger"></span>
			</div>
			
			<div class="d-grid">
				<button type="submit" class="btn btn-primary">Изпрати линк за смяна</button>
			</div>
		</form>
	</div>
</div>

@section Scripts {
@{
		await Html.RenderPartialAsync("_ValidationScriptsPartial.cshtml");
	}
}