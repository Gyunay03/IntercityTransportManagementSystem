@{
	ViewData["Title"] = "Генериране на линк за забравена парола";
	Layout = "~/Views/Shared/_AccountLayout.cshtml";
}

<div class="account-container">
	<div class="account-box text-center">
		<h2 class="mb-4">Заявката е успешна</h2>
		<p>Линкът за смяна на паролата ще бъде валиден за 1 час.</p>
		<a asp-controller="Account" asp-action="Login" class="btn btn-primary mt-3">Вход</a>

		@*За development среда - показване на тестовия линк *@
		@if (TempData["ResetLink"] != null)
		{
			<div class="alert alert-info mt-3" role="alert">
				<strong>Тестов линк: </strong>
				<a href="@TempData["ResetLink"]" target="_blank">@TempData["ResetLink"]</a>
			</div>
		}
	</div>
</div>

@section Scripts {
	@{
		await Html.RenderPartialAsync("_ValidationScriptsPartial.cshtml");
	}
}
