@model IntercityTransportManagementSystem.Models.Bus

@{
    ViewData["Title"] = "Добавяне на нов автобус";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4" style="max-width: 600px;">
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white text-center py-3">
            <h4 class="card-title mb-0"><i class="bg-info bi-pencil-square"></i>  Добавяне на нов автобус</h4>
        </div>
        <div class="card-body">
            <form asp-action="Create" method="post">
                <div asp-validation-summary="All" class="text-danger"></div>

                <div class="mb-3">
                    <label asp-for="RegistrationNumber" class="form-label"></label>
                    <input asp-for="RegistrationNumber" class="form-control" />
                    <span asp-validation-for="RegistrationNumber" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Capacity" class="form-label"></label>
                    <input asp-for="Capacity" class="form-control" />
                    <span asp-validation-for="Capacity" class="text-danger"></span>
                </div>

                <div class="card-footer bg-light text-center py-3">
                    <a asp-action="Index" class="btn btn-outline-secondary">Откажи</a>
                    <button type="submit" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i>  Добави</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}