@model IntercityTransportManagementSystem.Models.Bus

@{
    ViewData["Title"] = "Добавяне на нов автобус";
    Layout = "~/Views/Shared/_AdministratorLayout.cshtml";
}

<h2 class="text-center mb-4">Добавяне на нов автобус</h2>
<hr />
<div class="d-flex justify-content-center">
    <div style="max-width: 400px; width: 100%;">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            
            <div class="mb-3">
                <label asp-for="RegistrationNumber" class="form-label"></label>
                <input asp-for="RegistrationNumber" class="form-control" />
                <span asp-validation-for="RegistrationNumber" class="text-danger"></span>
            </div>
            
            <div class="mb-3">
                <label asp-for="Capacity" class="form-label"></label>
                <input asp-for="Capacity" class="form-control" />
                <span asp-validation-for="Capacity" class="text-danger"></span>
            </div>
            <div class="d-flex justify-content-center gap-2 mt-4">
                <a asp-action="Index" class="btn btn-secondary">Откажи</a>
                <input type="submit" value="Добави" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}