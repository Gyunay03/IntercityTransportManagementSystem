@model IntercityTransportManagementSystem.Models.Bus

@{
    ViewData["Title"] = "Детайли за автобус";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-info text-white text-center py-3">
                    <h2 class="h4 mb-0"><i class="bi bi-eye"></i>  Детайли за автобус</h2>
                </div>

                <div class="card-body py-4">
                    <div class="d-flex justify-content-center align-items-center gap-2 mb-2 fs-6">
                        <span class="fw-bold text-secondary">Регистрационен номер:</span>
                        <span class="fw-bold text-dark">@Model.RegistrationNumber</span>
                    </div>
                    
                    <div class="d-flex justify-content-center align-items-center gap-2 mb-2 fs-6">
                        <span class="fw-bold text-secondary">Капацитет:</span>
                        <span class="fw-bold text-dark">@Model.Capacity</span>
                    </div>
                </div>
                <div class="card-footer bg-light text-center py-3">
                    <a asp-action="Index" class="btn btn-outline-secondary">Назад</a>
                    <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-primary"><i class="bi bi-pencil"></i>  Редактирай</a>
                </div>
            </div>
        </div>
    </div>
</div>

