@using IntercityTransportManagementSystem.ViewModels
@model BusIndexViewModel
@{
    ViewData["Title"] = "Автобуси";
}

<div class="bus-container">
    <div class="bus-header">
        <h2>
            <img src="/images/bus.png" alt="Автобус" style="height: 2rem; width: auto; vertical-align: middle;" class="me-2" /> Автобуси
        </h2>
    </div>


    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body">
            
            <div class="text-center mb-3">
                <a asp-action="Create" class="btn btn-primary">
                    <i class="bi bi-plus-lg me-1"></i>  Добави нов автобус
                </a>
            </div>
            
            <form method="get" id="filterForm" class="row g-2 align-items-end">
                <div class="col-md-4">
                    <label for="searchString" class="form-label fw-bold">Търсене</label>
                    <input type="text" name="searchString"
                           class="form-control"
                           placeholder="Търси по регистрационен номер."
                           value="@Model.SearchString" />
                </div>

                <div class="col-md-2 d-grid">
                    <button type="submit" class="btn btn-outline-primary">
                        <i class="bi bi-search me-1"></i>  Търси
                    </button>
                </div>
            </form>

        </div>

        <div class="card shadow-sm border-0">
            <div class="card-body">
                <div class="table-responsive">
                    @if (!Model.Buses.Any())
                    {
                        <div class="alert alert-warning text-center">
                            Няма намерени автобуси.
                        </div>
                    }
                    else
                    {
                        <table class="table table-bordered text-center table-hover align-middle table-striped">
                            <thead class="table-info align-middle">
                                <tr>
                                    <th>
                                        <a asp-action="Index"
                                           asp-route-sortOrder="@(Model.SortOrder == "registrationNumber" ? "registrationNumber_descending" : "registrationNumber")"
                                           asp-route-searchString="@Model.SearchString"
                                           class="text-decoration-none text-dark fw-semibold">
                                            Регистрационен номер
                                        </a>
                                    </th>

                                    <th>
                                        <a asp-action="Index"
                                           asp-route-sortOrder="@(Model.SortOrder == "capacity" ? "capacity_descending" : "capacity")"
                                           asp-route-searchString="@Model.SearchString"
                                           class="text-decoration-none text-dark fw-semibold">
                                            Капацитет
                                        </a>
                                    </th>

                                    <th class="text-center">Действия</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.Buses)
                                {
                                    <tr>
                                        <td>@item.RegistrationNumber</td>
                                        <td>@item.Capacity</td>
                                        <td class="text-center">
                                            <div class="btn-group btn-group-sm">
                                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info">
                                                    <i class="bi bi-eye"></i>  Детайли
                                                </a>
                                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-primary">
                                                    <i class="bi bi-pencil"></i>  Редактирай
                                                </a>
                                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger">
                                                    <i class="bi bi-trash"></i>  Изтрий
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>

                        <nav>
                            <ul class="pagination justify-content-center">
                                <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                                    <a class="page-link"
                                       asp-action="Index"
                                       asp-route-page="@(Model.CurrentPage - 1)"
                                       asp-route-searchString="@Model.SearchString"
                                       asp-route-sortOrder="@Model.SortOrder">
                                        Назад
                                    </a>
                                </li>

                                @for (int i = 1; i <= Model.TotalPages; i++)
                                {
                                    <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                        <a class="page-link"
                                           asp-action="Index"
                                           asp-route-page="@i"
                                           asp-route-searchString="@Model.SearchString"
                                           asp-route-sortOrder="@Model.SortOrder">
                                            @i
                                        </a>
                                    </li>
                                }

                                <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                                    <a class="page-link"
                                       asp-action="Index"
                                       asp-route-page="@(Model.CurrentPage + 1)"
                                       asp-route-searchString="@Model.SearchString"
                                       asp-route-sortOrder="@Model.SortOrder">
                                        Напред
                                    </a>
                                </li>
                            </ul>
                        </nav>
                    }
                </div>
            </div>
            
        </div>
    </div>
</div>

<style>
    .bus-container {
        margin: 10px auto;
    }

    .bus-header {
        background-color: rgba(255, 255, 255, 0.88);
        padding: 14px 20px;
        margin-bottom: 16px;
        border-radius: 6px;
        text-align: center;
    }

    .bus-header h2 {
        font-size: 28px;
        font-weight: bold;
        margin: 0;
        color: #1f2937;
    }
</style>