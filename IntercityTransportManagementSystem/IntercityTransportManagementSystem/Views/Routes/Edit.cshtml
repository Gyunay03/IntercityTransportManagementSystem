@model IntercityTransportManagementSystem.Models.Route

@{
    ViewData["Title"] = "Редактиране на маршрут";
    Layout = "~/Views/Shared/_AdministratorLayout.cshtml";
}

<h2 class="text-center mb-4">Редактиране на маршрут</h2>
<div class="form-narrow">
    <form asp-action="Edit" asp-route-id="@Model.Id" method="post"> 
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <input type="hidden" asp-for="Id" />
        
        <div class="form-group">
            <label asp-for="StartDestination" class="form-label"></label>
            <input asp-for="StartDestination" class="form-control" />
            <span asp-validation-for="StartDestination" class="text-danger"></span>
        </div>
            
        <div class="form-group">
            <label asp-for="FinalDestination" class="form-label"></label>
            <input asp-for="FinalDestination" class="form-control" />
            <span asp-validation-for="FinalDestination" class="text-danger"></span>
        </div>
            
        <div class="form-group">
            <label asp-for="Distance" class="form-label"></label>
            <input asp-for="Distance" class="form-control" />
            <span asp-validation-for="Distance" class="text-danger"></span>
        </div>
            
        <div class="form-group">
            <label asp-for="EstimatedDuration" class="form-label"></label>
            <input asp-for="EstimatedDuration" class="form-control" />
            <span asp-validation-for="EstimatedDuration" class="text-danger"></span>
        </div>
        
        <div class="form-group">
            <label asp-for="TicketPrice" class="form-label">Цена на билет</label>
            <input asp-for="TicketPrice" class="form-control" type="number" step="0.01"/>
            <span asp-validation-for="TicketPrice" class="text-danger"></span>
        </div>
            
        <div class="d-flex justify-content-center gap-2 mt-4">
            <a asp-action="Index" class="btn btn-secondary">Откажи</a>
            <input type="submit" asp-action="Edit" value="Запази" class="btn btn-primary" />
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
