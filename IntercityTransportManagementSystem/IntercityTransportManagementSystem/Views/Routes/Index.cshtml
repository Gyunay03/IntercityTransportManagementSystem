@using IntercityTransportManagementSystem.ViewModels
@model RouteIndexViewModel

@{
    ViewData["Title"] = "Маршрути";
}

<div class="container mt-4">
    <div class="card shadow p-4">
        <h2 class="text-center mb-4">Маршрути</h2>

        <div class="text-center mb-3">
            <a asp-action="Create" class="btn btn-primary">Добави нов маршрут</a>
        </div>

        <form method="get" class="row g-2 mb-4">
            <div class="col-md-4 align-content-between">
                <input type="text" name="searchString" 
                    class="form-control"
                    placeholder="Търсене по начална/крайна дестинация."
                    value="@Model.SearchString" />
            </div>

            <div class="col-md-2 d-grid">
                <input type="submit" value="Търси" class="btn btn-outline-primary" />
            </div>
        </form>

        <div class="table-responsive">
            @if (!Model.Routes.Any())
            {
                <div class="alert alert-warning text-center">
                    Няма намерени маршрути.
                </div>
            }
            else
            {
                <table class="table table-bordered text-center table-hover align-middle table-striped">
                    <thead class="table-info align-middle">
                        <tr>
                            <th>
                                <a asp-action="Index"
                                   asp-route-sortOrder="@(Model.SortOrder == "startDestination" ? "startDestination_descending" : "startDestination")"
                                   asp-route-searchString="@Model.SearchString"
                                   class="text-decoration-none text-dark fw-semibold">
                                   Начална дестинация
                                </a>
                            </th>

                            <th>
                                <a asp-action="Index"
                                   asp-route-sortOrder="@(Model.SortOrder == "finalDestination" ? "finalDestination_descending" : "finalDestination")"
                                   asp-route-searchString="@Model.SearchString"
                                   class="text-decoration-none text-dark fw-semibold">
                                   Крайна дестинация
                                </a>
                            </th>

                            <th>
                                <a asp-action="Index"
                                   asp-route-sortOrder="@(Model.SortOrder == "distance" ? "distance_descending" : "distance")"
                                   asp-route-searchString="@Model.SearchString"
                                   class="text-decoration-none text-dark fw-semibold">
                                   Разстояние
                                </a>
                            </th>

                            <th>
                                <a asp-action="Index"
                                   asp-route-sortOrder="@(Model.SortOrder == "estimatedDuration" ? "estimatedDuration_descending" : "estimatedDuration")"
                                   asp-route-searchString="@Model.SearchString"
                                   class="text-decoration-none text-dark fw-semibold">
                                    Време за пътуване
                                </a>
                            </th>

                            <th class="text-center">Действия</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Routes)
                        {
                            <tr>
                                <td>@item.StartDestination</td>
                                <td>@item.FinalDestination</td>
                                <td>@item.Distance.ToString("F2") км</td>
                                <td>@item.EstimatedDuration</td>
                                <td class="text-center">
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-secondary">Детайли</a>
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-primary">Редактирай</a>
                                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger">Изтрий</a>
                                    </div>
                                </td>
                            </tr>    
                        }
                    </tbody>
                </table> 

                <nav>
                    <ul class="pagination justify-content-center">
                        <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                            <a class="page-link"
                               asp-action="Index"
                               asp-route-page="@(Model.CurrentPage - 1)"
                               asp-route-searchString="@Model.SearchString"
                               asp-route-sortOrder="@Model.SortOrder">
                               Назад
                            </a>
                        </li>

                        @for (int i = 1; i <= Model.TotalPages; i++)
                        {
                            <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                <a class="page-link"
                                   asp-action="Index"
                                   asp-route-page="@i"
                                   asp-route-searchString="@Model.SearchString"
                                   asp-route-sortOrder="@Model.SortOrder">
                                   @i
                                </a>
                            </li>    
                        }

                        <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                            <a class="page-link"
                               asp-action="Index"
                               asp-route-page="@(Model.CurrentPage + 1)"
                               asp-route-searchString="@Model.SearchString"
                               asp-route-sortOrder="@Model.SortOrder">
                               Напред
                            </a>
                        </li>
                    </ul>
                </nav>
            }
        </div>
    </div>
</div> 