@model IEnumerable<IntercityTransportManagementSystem.Models.Refund>
@using IntercityTransportManagementSystem.Enums

@{
    ViewData["Title"] = "Управление на възстановявания";
    decimal euroCourse = 1.95583m;
}

<div class="refund-container">
   <div class="refund-header">
       <h2>
            <i class="bi bi-cash-stack"></i>  
            Заявки за възстановяване на суми
       </h2>
        
   </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card shadow-sm">
        <div class="card-body">
            <table class="table table-bordered text-center table-hover align-middle table-striped">
                <thead class="table-info align-middle">
                    <tr>
                        <th>Дата на заявка</th>
                        <th>Маршрут</th>
                        <th>Дата и час на пътуване</th>
                        <th>Билет / Резервация</th>
                        <th>Сума</th>
                        <th>Статус</th>
                        <th>Действия</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.RequestDate.ToString("dd.MM.yyyy HH:mm")</td>
                            <td>@item.Payment.Reservation.Schedule.Route.StartDestination - @item.Payment.Reservation.Schedule.Route.FinalDestination</td>
                            <td>@item.Payment.Reservation.Schedule.TravelDate.ToString("dd.MM.yyyy") @item.Payment.Reservation.Schedule.DepartureTime.ToString("HH:mm") ч.</td>
                            <td>
                                <strong>#@item.Payment.ReservationId</strong><br />
                                <small class="text-muted">@item.Payment.Reservation.Passenger.Name @item.Payment.Reservation.Passenger.LastName</small>
                            </td>
                            <td class="fw-bold text-primary">
                                @{
                                    decimal amountInLeva = item.Amount * euroCourse;
                                }
                                <div>@item.Amount.ToString("F2") € / @amountInLeva.ToString("F2") лв.</div>
                            </td>
                            <td>
                                @if (item.Status == RefundStatus.Pending)
                                {
                                    <span class="badge bg-warning text-dark">Чакащо</span>
                                }
                                else if (item.Status == RefundStatus.Completed)
                                {
                                    <span class="badge bg-success">Завършено</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Отказано</span>
                                }
                            </td>
                            <td>
                                <div class="d-flex flex-column gap-2 align-items-center">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info">
                                        <i class="bi bi-eye"></i>  Детайли
                                    </a>

                                    @if (item.Status == RefundStatus.Pending)
                                    {
                                        <form asp-action="Approve" asp-route-id="@item.Id" method="post">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-success">
                                                <i class="bi bi-check-circle"></i>  Одобри
                                            </button>
                                        </form>

                                        <button type="button" class="btn btn-sm btn-outline-danger"
                                                data-bs-toggle="modal" data-bs-target="#rejectModal-@item.Id">
                                            <i class="bi bi-x-circle"></i>  Откажи
                                        </button>
                                    }
                                    else
                                    {
                                        <small class="text-muted">@item.ProcessedDate?.ToString("dd.MM.yyyy")</small>
                                    }
                                </div>

                                <div class="modal fade" id="rejectModal-@item.Id" tabindex="-1">
                                    <div class="modal-dialog">
                                        <div class="modal-content">
                                            <form asp-action="Reject" asp-route-id="@item.Id" method="post">
                                                @Html.AntiForgeryToken()
                                                <div class="modal-header">
                                                    <h5 class="modal-title">Отказ на възстановяване</h5>
                                                    <input type="button" class="btn-close" data-bs-dismiss="modal" />
                                                </div>
                                                <div class="modal-body">
                                                    <label>Причина за отказа:</label>
                                                    <textarea name="reason" class="form-control" required></textarea>
                                                </div>
                                                <div class="modal-footer">
                                                    <input type="button" class="btn btn-secondary" data-bs-dismiss="modal" value="Затвори" />
                                                    <input type="submit" class="btn btn-danger" value="Потвърди отказа" />
                                                </div>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<style>
    .refund-container {
        max-width: 1060px;
        margin: 20px auto;
    }

    .refund-header {
        background-color: rgba(255, 255, 255, 0.88);
        padding: 14px 20px;
        margin-bottom: 16px;
        border-radius: 6px;
        text-align: center;
    }

    .refund-header h2 {
        font-size: 28px;
        font-weight: bold;
        margin: 0;
        color: #1f2937;
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 10px;
    }
</style>