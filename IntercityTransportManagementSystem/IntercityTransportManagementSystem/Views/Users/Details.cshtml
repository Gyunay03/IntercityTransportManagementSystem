@model IntercityTransportManagementSystem.Models.User

@{
    ViewData["Title"] = "Детайли за потребител";
    Layout = "~/Views/Shared/_AdministratorLayout.cshtml";
}

<h2 class="text-center mb-4">Детайли за потребител</h2>

<div class="form-narrow">
    <hr />
    <dl class="row">
        <dt class = "col-sm-4">@Html.DisplayNameFor(model => model.Name)</dt>
        <dd class = "col-sm-8">@Html.DisplayFor(model => model.Name)</dd>
        
        <dt class = "col-sm-4">@Html.DisplayNameFor(model => model.LastName)</dt>
        <dd class = "col-sm-8">@Html.DisplayFor(model => model.LastName)</dd>
        
        <dt class = "col-sm-4">@Html.DisplayNameFor(model => model.Email)</dt>
        <dd class = "col-sm-8">@Html.DisplayFor(model => model.Email)</dd>
        
        <dt class = "col-sm-4">@Html.DisplayNameFor(model => model.Role)</dt>
        <dd class = "col-sm-8">@Html.DisplayFor(model => model.Role)</dd>
        
        <dt class = "col-sm-4">@Html.DisplayNameFor(model => model.IsActive)</dt>
        <dd class = "col-sm-8">
            @if (Model.IsActive)
            {
                <span class="badge bg-success">Активен</span>
            }
            else
            {
                <span class="badge bg-danger">Неактивен</span>
            }
        </dd>
        
        <dt class="col-sm-4">@Html.DisplayNameFor(model => model.IsEmailVerified)</dt>
        <dd class="col-sm-8">
            @if (Model.IsEmailVerified)
            {
                <span class="badge bg-success">Потвърден</span>
            }
            else
            {
                <span class="badge bg-danger">Непотвърден</span>    
            }
        </dd>

        <dt class = "col-sm-4">@Html.DisplayNameFor(model => model.CreatedAt)</dt>
        <dd class = "col-sm-8">
            @Model.CreatedAt.ToString("dd.MM.yyyy HH:mm")
        </dd>
    </dl>
    <div class="d-flex justify-content-center gap-2 mt-4">
        <a asp-action="Index" class="btn btn-secondary">Назад</a>
        <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-primary">Редактирай</a>
    </div>
</div>
