@{
	ViewData["Title"] = "Карта на маршрута";
}

<div class="container-fluid py-3">
	<div class="row mb-3 align-items-center">
		<div class="col-md-5 col-lg-4">
			<label for="lineSelect" class="form-label fw-bold">Изберете маршрут/линия</label>
			<div class="input-group">
				<span class="input-group-text bg-white"><i class="bi bi-bus-front"></i></span>
			</div>
			<select id="lineSelect" class="form-select">
				<option value="">Изберете линия</option>
			</select>
		</div>
	</div>
</div>

<div class="row g-3 mb-3">
	<div class="card border-0 shadow-sm bg-light">
		<div class="card-body p-3 d-flex align-items-center">
			<div class="fs-3 text-primary me-3"><i class="bi bi-clock-history"></i></div>
			<div>
				<div class="text-muted small">Очаквано пристигане</div>
				<div class="fw-bold fs-6" id="kpuEta">--:--</div>
			</div>
		</div>
	</div>
</div>
<div class="col-6 col-md-3">
	<div class="card border-0 shadow-sm bg-light">
		<div class="card-body p-3 d-flex align-items-center">
			<div class="fs-3 text-info me-3"><i class="bi bi-speedometer2"></i></div>
			<div>
				<div class="text-muted small">Текуща скорост</div>
				<div class="fw-bold fs-6" id="kpuEta">0 км/ч</div>
			</div>
		</div>
	</div>
</div>
<div class="col-6 col-md-3">
	<div class="card border-0 shadow-sm bg-light">
		<div class="card-body p-3 d-flex align-items-center">
			<div class="fs-3 text-success me-3"><i class="bi bi-activity"></i></div>
			<div>
				<div class="text-muted small">Статус</div>
				<div class="fw-bold fs-6" id="kpuEta">Няма данни</div>
			</div>
		</div>
	</div>
</div>

<div class="row g-3">
	<div class="col-lg-8">
		<div class="card border-0 shadow-sm">
			<div class="map-wrapper">
				<div id="map" style="height: 550px; width: 100%; border-radius: 6px;"></div>
				
				<div class="map-legend">	
					<div class="legend-items">
						<div class="legend-item">
							<img src="~/images/realTimeBusIcon.png" alt="Реално време" />
							<span>Реални данни</span>
						</div>
						<div class="legend-item">
							<img src="~/images/simulatedBusIcon.png" alt="Симулация" />
							<span>Симулация</span>
						</div>
					</div>
				</div>

				<button id="recenterBtn" class="btn btn-light shadow-sm map-recenter-btn d-none" title="Центрирай върху автобуса">
					<i class="bi bi-crosshair fs-5"></i>
				</button>
			</div>
		</div>
	</div>

	<div class="col-kg-4">
		<div class="card border-0 shadow-sm h-100">
			<div class="card-header bg-white py-3 border-0">
				<h5 class="card-title mb-0 fw-bold"><i class="bi bi-geo-alt me-2 text-primary"></i>  Маршрут и Спирки</h5>
			</div>
			<div class="card-body p-3 overflow-auto" style="max-height: 480px;">
				<ul class="timeline" id="stopsTimeline">
					<li class="text-muted small">Изберете маршрут, за да видите спирките.</li>
				</ul>
			</div>
		</div>
	</div>
</div>

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script src="~/lib/signalr.js"></script>

<script>
	// Инициализиране на картата
	var map = L.map('map').setView([42.7, 25.5], 7);

	L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
		attribution: '&copy; OpenStreetMap contributers'
	}).addTo(map);

	var currentTripId = null;
	var busMarker = null;
	var lastBusLatLng = null;
	var routeLayer = L.layerGroup().addTo(map);

	// Икони за автобус (различни цветове за реално време и симулация)
	var realTimeBusIcon = L.icon({
					iconUrl: '/images/realTimeBusIcon.png',
					iconSize: [35, 35],
					iconAnchor: [17, 17]
	});
	
	var simulatedBusIcon = L.icon({
					iconUrl: '/images/simulatedBusIcon.png',
					iconSize: [35, 35],
					iconAnchor: [17, 17]
	});

	function updateMarkerPosition(tripId, lat, lng, isRealTime, speed, etaText, capacityText) {
		// Превръщаме всичко в чисти типове за сигурност
		const tId = Number(tripId);
		const selId = Number(currentTripId);
		const isRT = Boolean(isRealTime);

		if(tId !== selId) return;

		const displaySpeed = speed ? Math.round(speed) : 0;
		const statusText = isRT ? "Реално време" : "Симулация";
		const icon = isRT ? realTimeBusIcon : simulatedBusIcon;

		// Обновяване на KPI картите
		document.getElementById('kpiSpeed').innerText = `${displaySpeed} км/ч`;
		document.getElementById('kpiStatus').innerText = displaySpeed > 0 ? "В движение" : "Спрял";
		if(etaText) document.getElementById('kpiEta').innerText = etaText;
		if(capacityText) document.getElementById('kpiCapacity').innerText = capacityText;

		const popupContent = `
			<div class="p-1">
				<div class="d-flex">
					<b>Превозно средство</b><br>
					<b>Тип данни:</b> ${statusText}<br>
					<b>Статус:</b> ${displaySpeed > 0 ? 'В движение' : 'Спрял на спирка'}<br>
					<b>Текуща скорост:</b> ${displaySpeed} км/ч
					`;

		if(busMarker === null) {
			console.log("Създаване на нов маркер за Trip", tId);
			busMarker = L.marker([lat, lng], {icon: icon, zIndexOffset: 1000 })
				.addTo(map)
				.bindPopup(popupContent);

			busMarker.isRealTimeStatus = isRT;
		} else {
				// Обновяваме позицията и текста
				busMarker.setLatLng([lat, lng]);
				busMarker.setPopupContent(popupContent);

				// Проверяваме дали статусът НАИСТИНА се е променил
				if(busMarker.isRealTimeStatus !== isRT) {
					console.log(`Смяна на иконата за Trip ${tId}: от ${busMarker.isRealTimeStatus} на ${isRT}`);
					busMarker.setIcon(isRealTime ? realTimeBusIcon : simulatedBusIcon);
					busMarker.isRealTimeStatus = isRT;
				}
		}
	}

	// Зареждане на линиите в падащото меню
	fetch('/api/lines')
		.then(res => res.json())
		.then(lines => {
			const select =document.getElementById('lineSelect');
			lines.forEach(line => {
				let opt = document.createElement('option');
				opt.value = line.defaultTripId;
				opt.innerHTML = line.name;
				select.appendChild(opt);
			});
		})
		.catch(err => console.error("Грешка при зареждане на линиите: ", err));

	// Функция за зареждане на конкретен маршрут
	function loadRoute(tripId) {
		if(!tripId || tripId === currentTripId) return;
		currentTripId = tripId;
		
		// Изчистване на картата от стария маршрут
		routeLayer.clearLayers();
		
		if(busMarker) {
			map.removeLayer(busMarker);
			busMarker = null;
		}

		// Извикване на API
		fetch(`/api/trips/${tripId}/full-path`)
			.then(res => {
				if(!res.ok) throw new Error("Липсва маршрут");
				return res.json();
			})
			.then(data => {
			// Преобразуване на данните в масив от [lat, lng] за Leaflet
			var latlngs = data.map(point => [point.lat, point.lng]);

				if(latlngs.length > 0) {
				// Чертаене на синята линия директно от точките в базата данни
				var polyline = L.polyline(latlngs, {color: 'blue', weight: 4}).addTo(routeLayer);
				map.fitBounds(polyline.getBounds());
				console.log("Маршрутът е зареден успешно от таблица Shapes.");

				return fetch(`/api/trips/${tripId}/live-position`);
				}	
			})
			.then(res => {
					if(res && res.ok) return res.json();
					return null;
			})
			.then(busData => {
				if(busData) {
					console.log("Първоначално разполагане на автобуса от базата данни:", busData);
					updateMarkerPosition(busData.tripId, busData.latitude, busData.longitude, busData.isRealTime, busData.speed);
				}
			})
			.catch(error => {
				console.warn(error.message);
				// Ако няма генериран маршрут, може да се извика автоматично генериране:
				fetch(`/api/trips/${tripId}/generate-shape`, { method: 'POST' })
					//.then(() => loadRoute(tripId));
			});
	}

	document.getElementById('lineSelect').addEventListener('change', function(e) {
		loadRoute(e.target.value);
	});

	const connection = new signalR.HubConnectionBuilder()
		.withUrl("/busHub")
		.withAutomaticReconnect()
		.build();

	connection.on("UpdateBusPosition", function (tripId, lat, lng, isRealTime, speed) {
		console.log("Получено обновяване през SignalR:", { tripId, lat, lng, isRealTime, speed });
		updateMarkerPosition(tripId, lat, lng, isRealTime, speed);
	});

	connection.start().then(function () {
		console.log("Успешно свързване със SignalR.");
	}).catch(function (err) {
		return console.error(err.toString());
	});
</script>

<style>
	.map-wrapper {
		position: relative;
	}

	.map-legend {
		position: absolute;
		left: 12px;
		bottom: 12px;
		z-index: 1000;
		display: flex;
		flex-direction: column;
		gap: 4px;
		align-items: center;
		background: #ffffff;
		border: 1px solid #dcdcdc;
		border-radius: 6px;
		padding: 8px 12px;
		font-size: 14px;
		box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
	}

	.legend-items {
		display: flex;
		align-items: center;
		gap: 18px;
	}
	
	.legend-item {
		display: flex;
		align-items: center;
		gap: 6px;
		white-space: nowrap;
	}

	.legend-item img {
		width: 24px;
		height: 24px;
	}

	.legend-attribution {
		margin-top: 4px;
		text-align: center;
	}
</style>