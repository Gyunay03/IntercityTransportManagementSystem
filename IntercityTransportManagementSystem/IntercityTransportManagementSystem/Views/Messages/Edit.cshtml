@model IntercityTransportManagementSystem.Models.Message

@{
    ViewData["Title"] = "Редактиране";
}

<div class="container mt-4" style="max-width: 600px;">
    <div class="card shadow-sm">
        <div class="card-header bg-warning text-dark">
            <h4 class="card-title mb-0"><i class="bi bi-pencil">Редактиране на съобщение</i></h4>
        </div>
        <div class="card-body">
            <form asp-action="Edit" method="post">
                <input type="hidden" asp-for="Id" />

                <div class="mb-3">
                    <label class="form-label">Текст на съобщението</label>
                    <textarea name="content" class="form-control" rows="5">@Model.Content</textarea>
                    <span asp-validation-for="Content" class="text-danger"></span>
                </div>

                <div class="d-flex justify-content-between">
                    <a asp-action="Index" class="btn btn-outline-secondary">Отказ</a>
                    <i class="bi bi-save"> <input type="submit" class="btn btn-warning" value="Запази промените" /></i>
                </div>
            </form>
        </div>
    </div>
</div>