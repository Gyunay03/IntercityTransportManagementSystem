@model List<Notification>

@{
	ViewData["Title"] = "Уведомления";
}

<div class="notification-container">
	<div class="notification-header">
		<h2>Уведомления</h2>
	</div>

	<div class="table-responsive">
		@if (!Model.Any())
		{
			<p class="empty-notifications">Нямате уведомления.</p>
		}
		else
		{
			<div>
				@foreach (var notification in Model)
				{
					<div class="notification-item @(notification.IsRead ? "read" : "unread")">
						<h4>
							@if (!notification.IsRead)
							{
								<span class="new-label">[Ново]</span>
							}

							@notification.Title
						</h4>

						<p>@notification.Message</p>

						<small>@notification.CreatedAt.ToString("dd.MM.yyyy HH:mm")</small>

						@if (!notification.IsRead)
						{
							<form asp-action="MarkAsRead" method="post">
								<input type="hidden" name="id" value="@notification.Id" />
								<input type="submit" class="btn btn-success" value="Маркирай като прочетено" />
							</form>
						}
					</div>
				}
			</div>
		}
	</div>
</div>



<style>
	.notification-container {
		max-width: 1060px;
		margin: 20px auto;
	}

	.notification-header {
		background-color: rgba(255, 255, 255, 0.88);
		padding: 14px 20px;
		margin-bottom: 16px;
		border-radius: 6px;
		text-align: center;
	}

	.notification-header h2 {
		font: 28px;
		font-weight: bold;
		margin: 0;
		color: #1f2937;
	}

	.notification-item {
		background-color: rgba(255, 255, 255, 0.94);
		border: 1px solid #ddd;
		padding: 12px;
		margin-bottom: 10px;
		border-radius: 6px;
	}

	.notification-item h4 {
		margin-top: 0;
	}

	.notification-item.unread {
		border-left: 5px solid #0d6efd;
		font-weight: 600;
	}

	.notification-item.read {
		opacity: 0.95;
	}

	.new-label {
		display: inline-block;
		background-color: #0d6efd;
		color: white;
		padding: 2px 8px;
		border-radius: 4px;
		font-size: 13px;
		margin-right: 8px;
	}

	.empty-notifications {
		background-color: rgba(255, 255, 255, 0.9);
		padding: 14px;
		border-radius: 6px;
	}
</style>