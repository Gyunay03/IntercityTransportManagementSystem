<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="utf-8"/>
	<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
	<title>@ViewBag.Title</title>
	<link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/>
	<link rel="stylesheet" href="~/css/account.css"/>
	<link rel="stylesheet" href="~/IntercityTransportManagementSystem.styles.css" asp-append-version="true"/>
</head>
<body>
	<header>
		<nav class="navbar navbar-expand-sm custom-header position-relative">
			<div class="container-fluid">
				<a class="navbar-brand center-navbar-title" asp-area="" asp-controller="Home" asp-action="Index">Система за управление на междуградски транспорт</a>
				<div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
					<ul class="navbar-nav flex-grow-1">
						<partial name="_LoginPartial"/>
					</ul>
				</div>
			</div>
		</nav>
	</header>
	<div>
		@RenderBody()
	</div>

	<footer class="custom-footer text-center">
		<div class="container">
			&copy; 2026 - Система за управление на междуградски транспорт. Всички права запазени!
		</div>
	</footer>

	<script src="~/lib/jquery/dist/jquery.min.js"></script>
	<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
	<script src="~/js/site.js" asp-append-version="true"></script>
	@await RenderSectionAsync("Scripts", required: false)
</body>
</html>