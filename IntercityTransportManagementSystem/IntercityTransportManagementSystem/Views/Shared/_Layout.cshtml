<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Система за управление на междуградски транспорт</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/IntercityTransportManagementSystem.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/seats.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
</head>
<body class="page-background">
    <header>
        <nav class="navbar navbar-expand-sm custom-header position-relative">
            <div class="container-fluid">
                <a class="navbar-brand center-navbar-title" asp-area="" asp-controller="Home" asp-action="Index">Система за управление на междуградски транспорт</a>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <div class="d-flex ms-auto align-items-center user-header-area">
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <a asp-controller="Notifications" asp-action="Index" class="notification-header-link">
                                <i class="bi bi-bell-fill"></i>
                                <span id="notification-count" class="notification-count">0</span>
                            </a>   
                            
                            <div class="dropdown">
                                <button class="btn user-dropdown-button dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-person-circle"></i>
                                    @User.Identity.Name
                                </button>

                                <ul class="dropdown-menu dropdown-menu-end">
                                <li>
                                    <a class="dropdown-item" asp-controller="Notifications" asp-action="Index">
                                        <i class="bi bi-bell"></i>  Уведомления
                                    </a>
                                </li> 
                                
                                    @if (User.IsInRole("Passenger"))
                                    {
                                        <li>
                                            <a class="dropdown-item" asp-controller="Account" asp-action="MyHistory">
                                                <i class="bi bi-ticket-perforated"></i>  Моите резервации и билети
                                            </a>
                                        </li>   
                                        
                                        <li>
                                            <a class="dropdown-item" asp-controller="Refunds" asp-action="MyRefunds">
                                                Анулирани плащания
                                            </a>
                                        </li>
                                    }

                                    <li><hr class="dropdown-divider" /></li>

                                    <li>
                                        <form asp-controller="Account" asp-action="Logout" method="post">
                                            <input type="submit" class="dropdown-item" value="Изход" />
                                        </form>
                                    </li>
                                </ul>
                            </div>
                        }
                        else
                        {
                            <partial name="_LoginPartial" />
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    @if (User.Identity != null && User.Identity.IsAuthenticated)
    {
        <div class="container-fluid">
            <div class="row flex-nowrap">
                <div class="col-auto col-md-3 col-xl-2 px-sm-2 sidebar">
                    <div class="d-flex flex-column align-items-center align-items-sm-start px-3 pt-2 text-white min-vh-100">
                        <ul class="nav nav-pills flex-column mb-sm-auto mb-0 align-items-center align-items-sm-start" id="menu">
                            <li class="nav-item">
                                <a asp-controller="Home" asp-action="Index" class="nav-link text-white">Начало</a>
                            </li>
                            
                            @if (User.IsInRole("Administrator"))
                            {
                                <li class="nav-item">
                                    <a asp-controller="Buses" asp-action="Index" class="nav-link text-white">
                                        <img src="/images/bus.png" alt="Автобуси" style="height: 2rem; width: auto;" class="sidebar-icon" />  Автобуси
                                    </a>
                                </li>    
                            }
                            
                            <li class="nav-item">
                                <a asp-controller="BusSchedules" asp-action="Index" class="nav-link text-white">
                                    <img src="/images/busSchedule.png" alt="Разписание на автобуси" style="height: 1.5rem; width: auto;" class="sidebar-icon" />  Разписание на автобуси
                                </a>
                            </li>
                            
                            <li class="nav-item">
                                <a asp-controller="Routes" asp-action="Index" class="nav-link text-white">
                                   <img src="/images/route.png" alt="" class="sidebar-icon" />  Маршрути
                                </a>
                            </li>
                            
                            @if (User.IsInRole("Administrator"))
                            {
                                <li class="nav-item">
                                    <a asp-controller="BusSeats" asp-action="Index" class="nav-link text-white">
                                      <img src="/images/seats.png" alt="" class="sidebar-icon" />  Места в автобус
                                    </a>
                                </li>
                            }
                            
                            <li class="nav-item">
                                <a asp-controller="Reservations" asp-action="Index" class="nav-link text-white">
                                    <img src="/images/reservation.png" alt="" class="sidebar-icon" />  Резервиране на място
                                </a>
                            </li>
                            
                            <li class="nav-item">
                                <a asp-controller="Payments" asp-action="Index" class="nav-link text-white">
                                    <img src="/images/ticket.png" alt="" class="sidebar-icon" />  Плащания
                                </a>
                            </li>
                            
                            @if (User.IsInRole("Administrator"))
                            {
                                <li class="nav-item">
                                    <a asp-controller="Users" asp-action="Index" class="nav-link text-white">
                                        <img src="/images/users.png" alt="" class="sidebar-icon" />  Потребители
                                    </a>
                                </li>
                            
                                <li class="nav-item">
                                    <a asp-controller="Drivers" asp-action="Index" class="nav-link text-white">
                                        <img src="/images/driver.png" alt="" class="sidebar-icon" />  Шофьори
                                    </a>
                                </li>

                                <li class="nav-item">
                                    <a asp-controller="Passengers" asp-action="Index" class="nav-link text-white">
                                        <img src="/images/passenger.png" alt="" class="sidebar-icon" />  Пътници
                                    </a>
                                </li>
                            }
                            @if (User.IsInRole("Passenger"))
                            {
                                <li class="nav-item">
                                    <a asp-controller="Account" asp-action="MyHistory" class="nav-link text-white">
                                        <img src="/images/my_tickets.png" alt="" class="sidebar-icon" />  Моите резервации и билети
                                    </a>
                                </li>
                            }
                            
                            @if (User.IsInRole("Administrator"))
                            {
                                <li class="nav-item">
                                    <a asp-controller="Refunds" asp-action="Index" class="nav-link text-white">
                                        <img src="/images/return_money.png" alt="" class="sidebar-icon" />  Анулирани плащания
                                    </a>
                                </li>
                            }     

                            <li class="nav-item">
                                <a asp-controller="Map" asp-action="Index" class="nav-link text-white">
                                    <img src="/images/live-tracking.png" alt="" class="sidebar-icon" />  Проследяване на маршрути
                                </a>
                            </li>
                            
                            <li class="nav-item">
                                <a asp-controller="Messages" asp-action="Index" class="nav-link text-white">
                                    <img src="~/images/messages.png" alt="" class="sidebar-icon" />  Изпращане на съобщение
                                </a>
                            </li>
                        </ul>
                    </div>
                </div>
                <div class="col py-3">
                    <main role="main">
						@RenderBody()
                    </main>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="container">
            <main role="main" class="pb-3">
                @RenderBody()
            </main>
        </div>
    }

    <footer class="custom-footer text-center">
        <div class="container">
            &copy; @DateTime.Now.Year - Система за управление на междуградски транспорт. Всички права запазени!
        </div>
    </footer>
    
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    
    <script>
        async function loadUnreadNotificationsCount() {
            try {
                const response = await fetch('/Notifications/UnreadCount');
                const count = await response.json();

                const badge = document.getElementById('notification-count');

                if(!badge) {
                    return;
                }

                if(count > 0) {
                    badge.textContent = count;
                    badge.style.display = 'inline-block';
                } else {
                    badge.style.display = 'none';
                }
            } catch {
                console.log('Неуспешно зареждане на броя уведомления.');
            }
        }

        loadUnreadNotificationsCount();
        setInterval(loadUnreadNotificationsCount, 30000);
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

<style>
    .sidebar-icon {
        width: 18px;
        height: 18px;
        margin-right: 6px;
        vertical-align: text-bottom;
    }

    .user-header-area {
        gap: 12px;
    }

    .notification-header-link {
        position: relative;
        color: white;
        font-size: 22px;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
    }

    .notification-header-link:hover {
        color: #f1f1f1;
    }

    .notification-count {
        position: absolute;
        top: -7px;
        right: -10px;
        background-color: #dc3545;
        color: white;
        font-size: 12px;
        min-width: 18px;
        height: 18px;
        border-radius: 50%;
        text-align: center;
        line-height: 18px;
        display: none;
    }

    .user-dropdown-button {
        background-color: #0aa000;
        color: white;
        border: none;
    }

    .user-dropdown-button:hover, .user-dropdown-button:focus {
        background-color: #088600;
        color: white;
    }
</style>