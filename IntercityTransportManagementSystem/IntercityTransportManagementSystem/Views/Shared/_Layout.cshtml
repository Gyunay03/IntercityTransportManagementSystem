<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Система за управление на междуградски транспорт</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/IntercityTransportManagementSystem.styles.css" asp-append-version="true" />
</head>
<body class="page-background">
    <header>
        <nav class="navbar navbar-expand-sm custom-header position-relative">
            <div class="container-fluid">
                <a class="navbar-brand center-navbar-title" asp-area="" asp-controller="Home" asp-action="Index">Система за управление на междуградски транспорт</a>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <div class="d-flex ms-auto">
                        <partial name="_LoginPartial" />
                    </div>
                </div>
            </div>
        </nav>
    </header>

    @if (User.Identity != null && User.Identity.IsAuthenticated)
    {
        <div class="container-fluid">
            <div class="row flex-nowrap">
                <div class="col-auto col-md-3 col-xl-2 px-sm-2 sidebar">
                    <div class="d-flex flex-column align-items-center align-items-sm-start px-3 pt-2 text-white min-vh-100">
                        <ul class="nav nav-pills flex-column mb-sm-auto mb-0 align-items-center align-items-sm-start" id="menu">
                            <li class="nav-item">
                                <a asp-controller="Home" asp-action="Index" class="nav-link text-white">Начало</a>
                            </li>
                            
                            @if (User.IsInRole("Administrator"))
                            {
                                <li class="nav-item">
                                    <a asp-controller="Buses" asp-action="Index" class="nav-link text-white">Автобуси</a>
                                </li>    
                            }
                            
                            <li class="nav-item">
                                <a asp-controller="BusSchedules" asp-action="Index" class="nav-link text-white">Разписание на автобуси</a>
                            </li>
                            
                            <li class="nav-item">
                                <a asp-controller="Routes" asp-action="Index" class="nav-link text-white">Маршрути</a>
                            </li>
                            
                            <li class="nav-item">
                                <a asp-controller="BusSeats" asp-action="Index" class="nav-link text-white">Места в автобус</a>
                            </li>
                            
                            <li class="nav-item">
                                <a asp-controller="Reservations" asp-action="Index" class="nav-link text-white">Резервиране на място</a>
                            </li>
                            
                            <li class="nav-item">
                                <a asp-controller="Payments" asp-action="Index" class="nav-link text-white">Купуване на билет</a>
                            </li>
                            
                            @if (User.IsInRole("Administrator"))
                            {
                            <li class="nav-item">
                                <a asp-controller="Users" asp-action="Index" class="nav-link text-white">Потребители</a>
                            </li>    
                            }
                        </ul>
                    </div>
                </div>
                <div class="col py-3">
                    @RenderBody()
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="container">
            <main role="main" class="pb-3">
                @RenderBody()
            </main>
        </div>
    }

    <footer class="custom-footer text-center">
        <div class="container">
            &copy; 2026 - Система за управление на междуградски транспорт. Всички права запазени!
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
