@model IntercityTransportManagementSystem.Models.BusSchedule

@{
    ViewData["Title"] = "Редактиране на разписание";
    Layout = "~/Views/Shared/_AdministratorLayout.cshtml";
}

<h2 class="text-center mb-4">Редактиране на разписание</h2>
<hr />
<div class="form-narrow">
        <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />
            
            <div class="form-group">
                <label asp-for="RouteId" class="form-label"></label>
                <select asp-for="RouteId" class="form-select" asp-items="ViewBag.RouteId"></select>
                <span asp-validation-for="RouteId" class="text-danger"></span>
            </div>
            
            <div class="form-group">
                <label asp-for="BusId" class="form-label"></label>
                <select asp-for="BusId" class="form-select" asp-items="ViewBag.BusId"></select>
                <span asp-validation-for="BusId" class="text-danger"></span>
            </div>
            
            <div class="form-group">
                <label asp-for="DriverId" class="form-label"></label>
                <select asp-for="DriverId" class="form-select" asp-items="ViewBag.DriverId"></select>
                <span asp-validation-for="DriverId" class="text-danger"></span>
            </div>
           
            <div class="form-group">
                <label asp-for="TravelDate" class="form-label"></label>
                <input asp-for="TravelDate" type="date" class="form-control" />
                <span asp-validation-for="TravelDate" class="text-danger"></span>
            </div>
            
            <div class="form-group">
                <label asp-for="DepartureTime" class="form-label"></label>
                <input asp-for="DepartureTime" type="time" class="form-control" />
                <span asp-validation-for="DepartureTime" class="text-danger"></span>
            </div>
            
            <div class="form-group">
                <label asp-for="ArrivalTime" class="form-label"></label>
                <input asp-for="ArrivalTime" type="time" class="form-control" />
                <span asp-validation-for="ArrivalTime" class="text-danger"></span>
            </div>
            
            <div class="d-flex justify-content-center gap-2 mt-4">
                <a asp-action="Index" class="btn btn-secondary">Откажи</a>
                <input type="submit" value="Запази" class="btn btn-primary" />
            </div>
        </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
